# Admin panel environment variables (copy to .env for local development)
# Default: production Hugging Face backend (works without a local API server)
VITE_API_BASE_URL=https://arrifection-happiness-exchange.hf.space
VITE_APP_NAME=Happiness Exchange Admin

# Optional — only when running FastAPI locally on port 8000:
# VITE_API_BASE_URL=http://localhost:8000

# VITE_API_URL is an alias for VITE_API_BASE_URL
