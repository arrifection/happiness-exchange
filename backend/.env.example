# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Local dev:  mongodb://localhost:27017
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# Name of the database
DB_NAME=happiness_exchange

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-value-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Email (Resend) — shared by main-site verification and admin team invites ─
# Get your API key from https://resend.com/api-keys
# If RESEND_API_KEY is empty, emails are not sent (invite links can be copied manually).
RESEND_API_KEY=
EMAIL_FROM=Happiness Exchange <verify@mail.happyexchange.net>
# RESEND_FROM_EMAIL is an alias for EMAIL_FROM
APP_BASE_URL=https://www.happyexchange.net
# Production: https://admin-panel-happy-exchange.vercel.app
# Local dev admin panel (vite --port 5200):
ADMIN_PANEL_URL=http://localhost:5200
# Set to true temporarily in HF Spaces to expose GET /api/auth/email-config-check
ENABLE_EMAIL_DIAGNOSTICS=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (optional — defaults are in config.py)
# ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# ── Cloudinary image uploads ────────────────────────────────────────────────
# Copy these from your Cloudinary product environment/API Keys page.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional: folder used to group uploaded listing images in Cloudinary.
CLOUDINARY_FOLDER=happiness-exchange/items

# Optional single-line Cloudinary URL (alternative to the three vars above):
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Local dev only: base URL returned for saved uploads when Cloudinary is not set.
# PUBLIC_API_BASE_URL=http://127.0.0.1:8000
