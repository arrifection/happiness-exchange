# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Local dev:  mongodb://localhost:27017
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# Name of the database
DB_NAME=happiness_exchange

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-value-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Email Verification (Brevo SMTP) ──────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=verify@happyexchange.net
APP_BASE_URL=http://127.0.0.1:5173

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (optional — defaults are in config.py)
# ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# ── Cloudinary image uploads ────────────────────────────────────────────────
# Copy these from your Cloudinary product environment/API Keys page.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional: folder used to group uploaded listing images in Cloudinary.
CLOUDINARY_FOLDER=happiness-exchange/items
