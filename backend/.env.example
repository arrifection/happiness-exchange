# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# Local dev example: mongodb://localhost:27017
# Atlas example:     mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# Name of the database to use inside MongoDB
DB_NAME=happiness_exchange

# JWT secret used to sign access tokens
JWT_SECRET_KEY=change-this-in-production

# JWT settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
