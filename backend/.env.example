# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ── MongoDB ────────────────────────────────────────────────────────────────
# Local dev example:  mongodb://localhost:27017
# Atlas example:      mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# Name of the database to use inside MongoDB
DB_NAME=happiness_exchange

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# ALLOWED_ORIGINS=http://localhost:5173,https://happiness-exchange.vercel.app
